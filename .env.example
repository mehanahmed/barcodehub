# PostgreSQL Database Connection
# Replace with your PostgreSQL connection string (Supabase, Neon, AWS RDS, Railway, or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barcodehub

# Signs login sessions. Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The site's one public address, used for canonical URLs, the sitemap and JSON-LD (default https://barcodehub.com).
# Vite reads VITE_* variables from apps/barcodehub/.env, so set it there. If it changes, also update
# apps/barcodehub/index.html, public/robots.txt and public/llms.txt, which hold the address as plain text.
VITE_SITE_URL=https://barcodehub.com

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=barcodehub-assets
R2_PUBLIC_URL=https://pub-yourbucketid.r2.dev
